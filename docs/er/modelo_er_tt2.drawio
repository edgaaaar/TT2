xt-align:right;color:#666;padding:0&quot;&gt;INTEGER&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:16px&quot;&gt;&lt;td style=&quot;width:46px;color:#7a3e00;font-size:9px;padding:0&quot;&gt;FK&lt;/td&gt;&lt;td style=&quot;padding:0&quot;&gt;diagnostico_id&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666;padding:0&quot;&gt;INTEGER&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:16px&quot;&gt;&lt;td style=&quot;width:46px;color:#7a3e00;font-size:9px;padding:0&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:0&quot;&gt;domicilio&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666;padding:0&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:16px&quot;&gt;&lt;td style=&quot;width:46px;color:#7a3e00;font-size:9px;padding:0&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:0&quot;&gt;telefono&lt;/td&gt;&lt;td style=&quot;text-align:right;color:#666;padding:0&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1682" y="986" width="270" height="112" as="geometry"/></mxCell><mxCell id="x8" value="&lt;b&gt;Módulos escalables (no implementados en TT2, DEC-15)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;MECIC&lt;/b&gt;: evaluación por dominios D0 a D23 se modelará como &lt;i&gt;instrumento&lt;/i&gt; (dominio = sección, criterio = pregunta, Sí/No/No aplica = opción) y reutilizará &lt;i&gt;periodo&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;INDICAS II&lt;/b&gt;: los 6 indicadores se modelarán como &lt;i&gt;instrumento&lt;/i&gt; (variables F1 = preguntas), con muestra y resultado por &lt;i&gt;periodo&lt;/i&gt;; concentrado F2 en &lt;i&gt;concentrado&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Ambos se activan mediante &lt;i&gt;modulo_sistema.habilitado&lt;/i&gt; sin cambios estructurales (RNF-017)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;f