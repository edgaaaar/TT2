# Copiar a .env y ajustar. Nunca versionar .env (RNF-019).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pic_dev
DB_USER=pic
DB_PASSWORD=cambiar
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar
JWT_EXPIRES_MINUTES=30

STORAGE_DIR=./storage
LOG_LEVEL=debug

# Solo desarrollo: contraseña de los usuarios demo creados por el seeder 900
SEED_DEMO_PASSWORD=
