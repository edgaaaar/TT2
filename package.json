{
  "name": "pic",
  "private": true,
  "description": "Plataforma Integrada de Calidad (P.I.C.) HIMFG. Trabajo Terminal 2026-B060, ESCOM-IPN.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0"
